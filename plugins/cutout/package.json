{
  "name": "cutout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "gSender plugin that cuts a rectangle (inside or outside the line) with adjustable corner radius and tabs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "clean": "rm -rf ui",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sienci/gsender-plugin-sdk": "^0.2.1",
    "@sienci/gviewer": "^0.1.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.168.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
