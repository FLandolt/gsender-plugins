{
	"id": "io.github.flandolt.vcarve",
	"name": "V-Carve",
	"version": "0.1.0",
	"engine": ">=1.6.0",
	"ui": {
		"entry": "ui/index.html",
		"contributions": [
			{
				"slot": "tools-page",
				"route": "vcarve",
				"label": "V-Carve"
			}
		]
	},
	"permissions": [
		"workspace:read",
		"visualizer:load"
	],
